# Copy to .env and fill in your own values. Never commit .env.
# Every entry here is a NAME ONLY — no real credentials belong in this file.

# ---- Speech to text (AssemblyAI) -------------------------------------------
# https://www.assemblyai.com/ — see docs/speech-pipeline.md
ASSEMBLYAI_API_KEY=

# ---- Reply generation ------------------------------------------------------
# The model provider is not decided yet. See docs/architecture.md.
LLM_API_KEY=
LLM_MODEL=

# ---- Text to speech --------------------------------------------------------
# Provider not decided yet. See docs/speech-pipeline.md.
TTS_API_KEY=
TTS_VOICE=

# ---- Backend ---------------------------------------------------------------
BACKEND_PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/soba?sslmode=disable

# ---- Device authentication -------------------------------------------------
# Shared secret the doll uses to authenticate to the backend.
# Interim scheme only — proper per-device credentials are an open question.
DEVICE_SHARED_SECRET=

# ---- Frontend --------------------------------------------------------------
VITE_API_URL=http://localhost:8080
