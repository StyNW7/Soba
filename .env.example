# Copy this file to .env, then fill every EMPTY value marked as required.
# Never commit .env. Generate 32-byte values with:
#   openssl rand -base64 32

# Local PostgreSQL / Compose
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
HTTP_PORT=8080

# Browser origin and policy (Vite proxies /v1 to the API)
PUBLIC_BASE_URL=http://localhost:5174
ALLOWED_WEB_ORIGINS=http://localhost:5174
POLICY_VERSION=pilot-v1
DATA_KEY_VERSION=1
MINOR_ENROLLMENT_ENABLED=false
PROVIDER_DELETION_REQUIRED=false

# Required 32-byte base64 secrets
DATA_ENCRYPTION_KEY=
CURSOR_HMAC_KEY=
AUDIT_HMAC_KEY=

# Identity provider (empty for the local health and API smoke setup)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5174/v1/auth/callback
MOBILE_RETURN_URI=

# Providers are disabled until credentials and reviewed content are configured.
VOICE_ENABLED=false
STT_PROVIDER=deepgram
TEXT_PROVIDER=openai
TTS_PROVIDER=openai
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=id
TEXT_MODEL=gpt-4.1-mini
TTS_MODEL=gpt-4o-mini-tts
CONTENT_PACK_PATH=

# Alerts are disabled until workload identity or Google credentials are configured.
ALERTS_ENABLED=false
FCM_PROJECT_ID=

# Optional operations
MAX_ACTIVE_SESSIONS=10
OBJECT_DIRECTORY=./private-data

POLICY_PUBLISHED_AT=2026-09-07T00:00:00Z

# Azure Andrew: TTS_PROVIDER=azure and TTS_MODEL=en-US-AndrewNeural. Use an F0 Speech resource.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ElevenLabs: TTS_PROVIDER=elevenlabs, TTS_MODEL=eleven_flash_v2_5. Free plans can use
# built-in voices only; library voices need a paid plan. TTS_FALLBACK_PROVIDER=groq
# retries a failed reply with Groq Orpheus before any audio has played.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_FALLBACK_PROVIDER=
# Private self-hosted Puck service: TTS_PROVIDER=kokoro, TTS_MODEL=am_puck
KOKORO_TTS_URL=
