# Reference target. Do not enable flash encryption or secure boot from this file.
# Production provisioning must enable those features through a reviewed release
# configuration after the board and manufacturing process are approved.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# protocomm's secure BLE transport uses the Bluedroid 4.2 GAP API.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_SOBA_OTA_ENABLED=n
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
